* {
    box-sizing: border-box;
}


/* =========================================================
   CONTENTS PAGE
========================================================= */

#contents-page {
    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding:
        70px
        30px;

    background:
        radial-gradient(
            ellipse at 50% 45%,
            #302a24 0%,
            #1d1a17 55%,
            #11100e 100%
        );

    color:
        #30271e;

    font-family:
        Georgia,
        "Times New Roman",
        serif;
}


/* =========================================================
   PAPER
========================================================= */

#contents-page .contents-paper {
    position: relative;

    width:
        min(1000px, 100%);

    min-height:
        760px;

    padding:
        70px
        85px
        55px;

    overflow: hidden;

    background:
        radial-gradient(
            ellipse at 50% 45%,
            #eee3c9 0%,
            #e6d8b9 38%,
            #d4bf95 75%,
            #b99b6d 100%
        );

    border:
        1px solid
        rgba(73, 48, 24, 0.45);

    box-shadow:
        0 45px 100px
        rgba(0, 0, 0, 0.7),

        inset 0 0 100px
        rgba(72, 43, 18, 0.28),

        inset 0 0 25px
        rgba(55, 37, 22, 0.22);

    isolation: isolate;
}


/* =========================================================
   PAPER FIBERS
========================================================= */

#contents-page .contents-paper::before {
    content: "";

    position: absolute;

    inset: -10%;

    pointer-events: none;

    opacity: 0.45;

    background-image:

        radial-gradient(
            rgba(69, 45, 24, 0.25)
            0.45px,
            transparent 0.8px
        ),

        radial-gradient(
            rgba(255, 248, 221, 0.35)
            0.5px,
            transparent 0.9px
        );

    background-size:
        6px 7px,
        13px 11px;

    mix-blend-mode:
        multiply;
}


/* =========================================================
   AGING / STAINS
========================================================= */

#contents-page .contents-paper::after {
    content: "";

    position: absolute;

    inset: -15%;

    pointer-events: none;

    opacity: 0.75;

    background:

        radial-gradient(
            ellipse at 8% 13%,
            rgba(105, 69, 32, 0.22),
            transparent 13%
        ),

        radial-gradient(
            ellipse at 4% 52%,
            rgba(91, 58, 27, 0.15),
            transparent 15%
        ),

        radial-gradient(
            ellipse at 94% 10%,
            rgba(92, 61, 31, 0.19),
            transparent 16%
        ),

        radial-gradient(
            ellipse at 98% 55%,
            rgba(76, 50, 27, 0.18),
            transparent 14%
        ),

        radial-gradient(
            ellipse at 7% 91%,
            rgba(82, 51, 24, 0.26),
            transparent 18%
        ),

        radial-gradient(
            ellipse at 92% 91%,
            rgba(77, 49, 24, 0.23),
            transparent 20%
        ),

        radial-gradient(
            ellipse at center,
            transparent 30%,
            rgba(111, 75, 34, 0.08) 65%,
            rgba(75, 46, 21, 0.22) 100%
        );

    mix-blend-mode:
        multiply;

    filter:
        blur(1px);
}


/* =========================================================
   CONTENT LAYER
========================================================= */

#contents-page .contents-paper > * {
    position: relative;

    z-index: 5;
}


/* =========================================================
   HEADER
========================================================= */

#contents-page .contents-header {
    position: relative;

    text-align: center;
}


/* =========================================================
   SMALL LABEL
========================================================= */

#contents-page .contents-about-label {
    margin-bottom:
        17px;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        10px;

    letter-spacing:
        0.35em;

    color:
        rgba(67, 52, 36, 0.68);
}


/* =========================================================
   MAIN TITLE
========================================================= */

#contents-page .contents-book-name {
    display: block;

    margin: 0;

    font-size:
        clamp(38px, 5vw, 62px);

    font-weight:
        400;

    letter-spacing:
        0.08em;

    line-height:
        1;

    color:
        rgba(43, 33, 23, 0.88);

    text-shadow:
        0.4px 0
        rgba(35, 25, 17, 0.25);
}


/* =========================================================
   ABOUT
========================================================= */

#contents-page .contents-about {
    margin-top:
        25px;

    text-align:
        center;
}


#contents-page .contents-about-text {
    margin:
        17px
        0
        0;

    font-size:
        15px;

    font-style:
        italic;

    letter-spacing:
        0.08em;

    color:
        rgba(91, 73, 51, 0.72);
}


/* =========================================================
   ORNAMENT
========================================================= */

#contents-page .contents-about::after {
    content:
        "✦";

    display:
        block;

    margin:
        27px
        auto
        42px;

    font-size:
        15px;

    color:
        rgba(104, 76, 39, 0.78);
}


/* =========================================================
   CONTENTS HEADING
========================================================= */

#contents-page .contents-items {
    border-top:
        1px solid
        rgba(72, 51, 28, 0.28);
}


#contents-page .contents-items::before {
    content:
        "CONTENTS";

    display:
        flex;

    align-items:
        center;

    height:
        65px;

    font-size:
        21px;

    font-weight:
        400;

    letter-spacing:
        0.22em;

    color:
        rgba(48, 38, 27, 0.9);
}


/* =========================================================
   VIDEO ITEM
========================================================= */

#contents-page .contents-video-item {
    position:
        relative;

    display:
        grid;

    grid-template-columns:
        65px
        minmax(0, 1fr)
        230px;

    align-items:
        center;

    gap:
        25px;

    min-height:
        145px;

    padding:
        17px
        15px;

    color:
        inherit;

    text-decoration:
        none;

    border-top:
        1px solid
        rgba(76, 55, 31, 0.23);

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        padding 0.35s ease;
}


/* =========================================================
   NUMBER
========================================================= */

#contents-page .contents-video-number {
    font-size:
        27px;

    font-weight:
        400;

    color:
        rgba(94, 72, 45, 0.75);

    letter-spacing:
        0.04em;

    text-shadow:
        0 0.2px
        rgba(42, 30, 19, 0.25);
}


/* =========================================================
   TITLE
========================================================= */

#contents-page .contents-video-main {
    min-width:
        0;
}


#contents-page .contents-video-title {
    position:
        relative;

    display:
        inline-block;

    padding:
        0;

    border:
        0;

    background:
        transparent;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        18px;

    letter-spacing:
        0.055em;

    line-height:
        1.35;

    color:
        rgba(43, 33, 23, 0.88);

    text-align:
        left;

    cursor:
        pointer;

    transition:
        transform 0.35s ease;
}


/* =========================================================
   TITLE UNDERLINE
========================================================= */

#contents-page .contents-video-title::after {
    content:
        "";

    position:
        absolute;

    left:
        0;

    bottom:
        -7px;

    width:
        0;

    height:
        1px;

    background:
        #4d392b;

    transition:
        width .35s ease;
}


/* =========================================================
   HOVER
========================================================= */

#contents-page .contents-video-item:hover {
    transform:
        translateX(8px);

    padding-left:
        22px;

    background:
        rgba(255, 246, 215, 0.18);
}


#contents-page .contents-video-item::before {
    content:
        "";

    position:
        absolute;

    left:
        0;

    top:
        0;

    width:
        2px;

    height:
        0;

    background:
        rgba(100, 72, 39, 0.72);

    transition:
        height 0.35s ease;
}


#contents-page .contents-video-item:hover::before {
    height:
        100%;
}


#contents-page .contents-video-title:hover {
    transform:
        scale(1.035);

    transform-origin:
        left center;
}


#contents-page .contents-video-title:hover::after {
    width:
        100%;
}


/* =========================================================
   YOUTUBE THUMBNAIL
========================================================= */

#contents-page .contents-youtube {
    position:
        relative;

    display:
        block;

    width:
        230px;

    height:
        130px;

    overflow:
        hidden;

    text-decoration:
        none;

    border:
        1px solid
        rgba(73, 48, 24, 0.35);

    box-shadow:
        0 8px 20px
        rgba(45, 28, 15, 0.25);

    transition:
        transform .35s ease,
        box-shadow .35s ease;
}


#contents-page .contents-youtube img {
    display:
        block;

    width:
        100%;

    height:
        100%;

    object-fit:
        cover;

    filter:
        sepia(0.12)
        contrast(0.92)
        saturate(0.82);

    transition:
        transform .5s ease;
}


#contents-page .contents-youtube:hover {
    transform:
        translateY(-4px);

    box-shadow:
        0 14px 30px
        rgba(45, 28, 15, 0.38);
}


#contents-page .contents-youtube:hover img {
    transform:
        scale(1.045);
}


/* =========================================================
   TOP / BOTTOM LINES
========================================================= */

#contents-page .contents-items {
    position:
        relative;
}


#contents-page .contents-items::after {
    content:
        "";

    display:
        block;

    height:
        1px;

    margin-top:
        0;

    background:
        rgba(76, 55, 31, 0.23);
}


/* =========================================================
   MOBILE
========================================================= */

@media (
    max-width: 700px
) {

    #contents-page {
        padding:
            20px
            10px;
    }


    #contents-page .contents-paper {
        min-height:
            auto;

        padding:
            55px
            28px
            40px;
    }


    #contents-page .contents-book-name {
        font-size:
            34px;
    }


    #contents-page .contents-video-item {
        grid-template-columns:
            42px
            minmax(0, 1fr);

        gap:
            12px;

        padding:
            18px
            5px;
    }


    #contents-page .contents-video-number {
        font-size:
            20px;
    }


    #contents-page .contents-video-title {
        font-size:
            15px;
    }


    #contents-page .contents-youtube {
        grid-column:
            2;

        width:
            100%;

        height:
            auto;

        aspect-ratio:
            16 / 9;
    }


    #contents-page .contents-items::before {
        font-size:
            17px;

        letter-spacing:
            0.16em;
    }

}
