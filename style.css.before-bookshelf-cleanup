/* =========================================================
   READER
========================================================= */

.book-heading {
    position: relative;

    padding: 8px 0 24px;

    text-align: center;
}

.book-heading::after {
    display: block;

    width: 46px;
    height: 1px;

    margin: 15px auto 0;

    background: #9b7a43;

    content: "";
}

.book-heading h2 {
    margin: 8px 0 0;

    color: #f4efe5;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: clamp(25px, 4vw, 34px);
    font-weight: normal;

    line-height: 1.2;

    letter-spacing: .015em;

    text-shadow:
        0 1px 2px rgba(0, 0, 0, .18);
}

.book-heading .section-label {
    color: #c9b58e;

    font-size: 9px;
    letter-spacing: .24em;
}

.reader-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 38px;

    margin-bottom: 20px;

    padding-bottom: 11px;

    border-bottom:
        1px solid rgba(128, 108, 77, .25);
}

.back-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 5px 0;

    border: 0;

    color: #c9b58e !important;
    background: transparent;

    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 600;

    letter-spacing: .1em;

    transition:
        color .2s ease,
        transform .2s ease;
}

.back-button::before {
    content: "←";

    font-size: 13px;
    line-height: 1;
}

.back-button:hover {
    color: #f4efe5 !important;

    transform: translateX(-2px);
}

.progress {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin: 0;

    color: #aeb5b5;

    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 600;

    letter-spacing: .1em;
}

.progress::before {
    width: 26px;
    height: 1px;

    background: rgba(212, 175, 99, .5);

    content: "";
}


/* =========================================================
   BOOK SHELL
========================================================= */

.book-shell {
    position: relative;

    padding: 10px 15px 15px;

    border: 1px solid rgba(212, 175, 99, .18);
    border-radius: 4px;

    background:
        linear-gradient(
            145deg,
            #4c3321,
            #704b2f 48%,
            #4a3020
        );

    box-shadow:
        0 22px 42px rgba(0, 0, 0, .32),
        0 1px 0 rgba(255, 255, 255, .08) inset;
}

.vocabulary-page {
    position: relative;

    overflow: hidden;

    border: 1px solid rgba(130, 101, 59, .22);

    background:
        radial-gradient(
            ellipse at 50% 0%,
            rgba(255, 255, 255, .65),
            transparent 55%
        ),
        #fffaf0;

    box-shadow:
        inset 0 0 42px rgba(103, 73, 35, .11),
        inset 0 1px 0 rgba(255, 255, 255, .8),
        0 15px 28px rgba(34, 22, 12, .22);

    touch-action: pan-y;
}

.vocabulary-page::before {
    display: block;

    height: 7px;

    margin: -10px -15px 9px;

    opacity: .72;

    background:
        repeating-linear-gradient(
            60deg,
            transparent 0 12px,
            rgba(120, 34, 37, .42) 13px 14px,
            transparent 15px 27px
        ),
        repeating-linear-gradient(
            -60deg,
            transparent 0 12px,
            rgba(120, 34, 37, .32) 13px 14px,
            transparent 15px 27px
        );

    content: "";
}


/* =========================================================
   WORD LIST
========================================================= */

.word-list {
    margin: 0;
    padding: 0;

    list-style: none;

    counter-reset: vocabulary;
}

.word-entry {
    position: relative;

    min-height: 125px;

    border-bottom:
        1px solid #ded2bf;

    counter-increment: vocabulary;
}

.word-entry:last-child {
    border-bottom: 0;
}

.word-entry::before {
    position: absolute;
    z-index: 2;

    top: 18px;
    left: 12px;

    color: #b09570;

    content:
        counter(vocabulary, decimal-leading-zero);

    font-family: Arial, sans-serif;
    font-size: 11px;

    letter-spacing: .08em;
}

.word-flip {
    display: block;

    width: 100%;
    min-height: 124px;

    padding: 18px 125px 18px 55px;

    border: 0;

    color: inherit;
    background: transparent;

    font: inherit;

    text-align: left;
}

.word-flip-inner {
    position: relative;

    display: block;

    min-height: 85px;

    transform-style: preserve-3d;

    transition:
        transform .5s cubic-bezier(.2, .75, .25, 1);
}

.word-flip.is-flipped .word-flip-inner {
    transform:
        rotateX(180deg);
}

.word-face {
    display: block;

    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
}

.word-back {
    position: absolute;

    inset: 0;

    transform:
        rotateX(180deg);
}

.word {
    color: #292218;

    font-size: clamp(24px, 3.9vw, 31px);
    font-weight: bold;

    line-height: 1.3;
}

.meaning {
    color: #9a7041;

    font-size: clamp(19px, 3vw, 23px);
    font-weight: bold;
}

.word-level {
    display: inline-block;

    margin-left: 8px;
    padding: 4px 7px;

    border-radius: 2px;

    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: bold;

    letter-spacing: .08em;

    vertical-align: middle;
}

.level-easy {
    color: #346550;
    background: #dcece0;
}

.level-medium {
    color: #886225;
    background: #f1e4be;
}

.level-advanced {
    color: #883d3f;
    background: #f0d9d7;
}

.example {
    display: block;

    margin-top: 11px;

    color: #403729;

    font-size: clamp(16px, 2.6vw, 18px);
    font-style: italic;

    line-height: 1.55;
}

.translation {
    display: block;

    margin-top: 9px;

    color: #796e5f;

    font-size: clamp(15px, 2.5vw, 17px);

    line-height: 1.55;
}


/* =========================================================
   FLIP HINT
========================================================= */

.word-flip-hint {
    position: absolute;
    z-index: 3;

    top: 63px;
    right: 46px;

    display: block;

    width: 82px;

    color: #ad9b82;

    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;

    letter-spacing: .08em;

    line-height: 1.2;

    text-align: center;

    white-space: nowrap;

    pointer-events: none;
}

.word-flip-front-hint {
    display: inline-flex;
}

.word-flip-return-hint {
    display: none;
}

.word-entry > .word-flip-front-hint {
    display: inline-flex;
}

.word-entry:has(.word-flip.is-flipped)
> .word-flip-front-hint {
    display: none;
}

.word-entry:has(.word-flip.is-flipped)
> .word-flip-return-hint {
    display: inline-flex;
}


/* =========================================================
   SOUND
========================================================= */

.speak-button {
    position: absolute;
    z-index: 3;

    top: 14px;
    right: 15px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    width: 84px;
    height: 42px;

    border: 1px solid #c9b48a;
    border-radius: 8px;

    color: #604424;
    background: #fffaf0;

    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
}

.speak-button::after {
    content: "Sound";
}


/* =========================================================
   MASTERED
========================================================= */

.master-button,
.cancel-button {
    position: absolute;
    z-index: 3;

    right: 15px;
    bottom: 12px;

    min-width: 84px;
    min-height: 38px;

    padding: 7px 11px;

    border-radius: 8px;

    font-family: Arial, sans-serif;
    font-size: 12px;
    font-weight: bold;
}

.master-button {
    border: 0;

    color: #fff7eb;

    background: #9d2c2e;
}

.cancel-button {
    border: 1px solid #607570;

    color: #38534d;
    background: #f8fbf8;
}

.word-entry.is-mastered::after {
    position: absolute;
    z-index: 4;

    inset: 0;

    display: grid;
    place-items: center;

    color: rgba(92, 111, 106, .76);

    background:
        repeating-linear-gradient(
            45deg,
            transparent 0 14px,
            rgba(193, 205, 202, .72) 15px 16px,
            transparent 17px 29px
        ),
        rgba(255, 250, 240, .28);

    content: "🕸";

    font-size: 44px;

    pointer-events: none;
}

.word-entry.is-mastered .word-flip {
    opacity: .48;
}


/* =========================================================
   PAGE TURN
========================================================= */

.page-turn {
    position: absolute;
    z-index: 5;

    top: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 3px;

    width: 66px;
    height: 106px;

    padding: 0 7px;

    border: 0;

    color: #f8ead0;

    background:
        linear-gradient(
            90deg,
            #573920,
            #855936
        );

    box-shadow:
        0 7px 12px rgba(46, 27, 12, .38);

    font-family: Arial, sans-serif;

    transform:
        translateY(-50%);

    user-select: none;
}

.page-turn span {
    font-family: Georgia, serif;
    font-size: 44px;
}

.page-turn small {
    font-size: 8px;
    font-weight: bold;
}

.page-turn-left {
    left: -37px;
}

.page-turn-right {
    right: -37px;
}

.page-turn:disabled {
    opacity: .3;

    cursor: default;
}

.flip-guide {
    margin: 18px 0;

    color: #766b5d;

    font-size: 14px;

    text-align: center;
}


/* =========================================================
   PAGE TURN ANIMATION
========================================================= */

.page-turn-next {
    animation:
        pageNext .48s cubic-bezier(.2, .8, .25, 1);
}

.page-turn-previous {
    animation:
        pagePrevious .48s cubic-bezier(.2, .8, .25, 1);
}

@keyframes pageNext {

    0% {
        opacity: .5;

        transform:
            perspective(1200px)
            rotateY(-70deg);

        transform-origin:
            left center;
    }

    100% {
        opacity: 1;

        transform:
            perspective(1200px)
            rotateY(0);

        transform-origin:
            left center;
    }
}

@keyframes pagePrevious {

    0% {
        opacity: .5;

        transform:
            perspective(1200px)
            rotateY(70deg);

        transform-origin:
            right center;
    }

    100% {
        opacity: 1;

        transform:
            perspective(1200px)
            rotateY(0);

        transform-origin:
            right center;
    }
}


/* =========================================================
