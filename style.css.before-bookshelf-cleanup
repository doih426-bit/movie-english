/* =========================================================
   BASE
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
}

body {
    position: relative;

    color: #f1ede4;

    background:
        radial-gradient(
            circle at 50% 0%,
            #202a30 0,
            #151b1f 35%,
            #0c1012 100%
        );

    font-family:
        Georgia,
        "Hiragino Mincho ProN",
        "Yu Mincho",
        serif;

    overscroll-behavior-x: none;
}

button {
    cursor: pointer;
    font: inherit;
}

.hidden {
    display: none !important;
}


/* =========================================================
   HEADER
========================================================= */

header {
    position: relative;

    padding: 42px 20px 38px;

    color: #fff9ef;
    text-align: center;

    border-bottom: 1px solid rgba(212, 175, 99, .18);

    background:
        radial-gradient(
            circle at 50% -30%,
            #344652 0,
            #1b252c 35%,
            #101518 72%,
            #0b0f11 100%
        );

    box-shadow:
        0 15px 40px rgba(0, 0, 0, .35);
}

.site-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: min(100%, 820px);
    margin: 0 auto;
}

.site-header-top h1 {
    margin: 8px 0 10px;

    color: #f5f0e6;

    font-size: clamp(32px, 5vw, 44px);
    font-weight: normal;

    letter-spacing: .04em;

    text-shadow:
        0 2px 18px rgba(255, 255, 255, .07);
}

.site-header-top > div > p:last-child {
    margin: 0;

    color: #aeb5b5;

    font-family: Arial, sans-serif;
    font-size: 13px;

    letter-spacing: .03em;
}


/* =========================================================
   LOGOUT
========================================================= */

.logout-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 9px 15px;

    border: 1px solid rgba(212, 175, 99, .35);
    border-radius: 3px;

    color: #d9d6cf;
    background: transparent;

    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: bold;

    letter-spacing: .08em;

    transition:
        border-color .2s ease,
        color .2s ease,
        background .2s ease,
        transform .2s ease;
}

.logout-button::before {
    content: "↪";

    font-size: 16px;
    line-height: 1;
}

.logout-button:hover {
    border-color: #d4af63;

    color: #f5f0e6;

    background: rgba(212, 175, 99, .06);

    transform: translateY(-1px);
}


/* =========================================================
   LABELS
========================================================= */

.eyebrow,
.section-label,
.card-label {
    margin: 0;

    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: bold;

    letter-spacing: .16em;
}

.eyebrow {
    color: #d4af63;
}

.section-label {
    color: #d4af63;

    font-size: 10px;

    letter-spacing: .22em;
}


/* =========================================================
   MAIN
========================================================= */

main {
    width: min(100% - 32px, 820px);

    margin: 48px auto 70px;
}

main h2 {
    margin: 7px 0 24px;

    color: #f1ede4;

    font-size: 27px;
    font-weight: normal;

    letter-spacing: .02em;
}


/* =========================================================
   MOVIE CARD BASE
========================================================= */

.movie-card {
    display: flex;
    align-items: center;

    width: 100%;

    padding: 22px;

    border: 0;
    border-radius: 12px;

    color: inherit;
    background: #fffaf0;

    box-shadow:
        0 10px 25px rgba(69, 51, 28, .15);

    text-align: left;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.movie-card:hover {
    transform: translateY(-2px);

    box-shadow:
        0 12px 24px rgba(37, 32, 24, .10);
}


/* =========================================================
   MOVIE IMAGE
========================================================= */

.movie-image {
    display: grid;
    place-items: center;

    flex-shrink: 0;

    width: 76px;
    height: 96px;

    border-radius: 4px;

    background: #9d2c2e;

    box-shadow:
        4px 4px 0 #592123;

    font-size: 43px;
}


/* =========================================================
   BOOK INFO
========================================================= */

.book-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 7px;

    padding: 0 22px;
}

.book-info strong {
    font-size: 24px;
}

.book-info span {
    color: #766b5d;

    font-family: Arial, sans-serif;
    font-size: 14px;
}


/* =========================================================
   CINEMA STUDIES / ANTIQUE BOOKSHELF
========================================================= */

.collection-book {
    position: relative;

    display: block;

    width: 100%;
    min-height: 330px;

    padding: 34px 34px 30px;

    overflow: hidden;

    border: 1px solid rgba(155, 122, 67, .42);
    border-radius: 2px;

    color: #eee4d0;

    background:
        linear-gradient(
            180deg,
            #30251b 0%,
            #211913 42%,
            #17110d 100%
        );

    box-shadow:
        0 24px 48px rgba(0, 0, 0, .32),
        0 2px 0 rgba(255, 255, 255, .035) inset,
        0 -12px 28px rgba(0, 0, 0, .16) inset;

    text-align: left;

    transition:
        transform .28s cubic-bezier(.16, 1, .3, 1),
        box-shadow .28s ease,
        border-color .28s ease;
}

.collection-book::before {
    position: absolute;

    top: 0;
    right: 0;
    bottom: 0;
    left: 0;

    background:
        radial-gradient(
            ellipse at 50% 0%,
            rgba(214, 178, 104, .09),
            transparent 48%
        ),
        linear-gradient(
            90deg,
            transparent 0 4%,
            rgba(212, 175, 99, .035) 4.2% 4.5%,
            transparent 4.7% 95.3%,
            rgba(212, 175, 99, .035) 95.5% 95.8%,
            transparent 96%
        );

    content: "";

    pointer-events: none;
}

.collection-book::after {
    position: absolute;

    inset: 13px;

    border: 1px solid rgba(212, 175, 99, .12);

    content: "";

    pointer-events: none;
}

.collection-book:hover {
    border-color: rgba(212, 175, 99, .62);

    transform: translateY(-2px);

    box-shadow:
        0 28px 52px rgba(0, 0, 0, .36),
        0 2px 0 rgba(255, 255, 255, .045) inset,
        0 -12px 28px rgba(0, 0, 0, .18) inset;
}

.collection-book[aria-expanded="true"] {
    border-color: rgba(212, 175, 99, .58);

    transform: translateY(-1px);
}

.collection-book .movie-image {
    position: absolute;
    z-index: 1;

    left: 50%;
    bottom: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 118px;
    height: 166px;

    border: 1px solid rgba(183, 148, 78, .48);
    border-radius: 1px;

    color: #c93440;

    background:
        radial-gradient(
            circle at 50% 38%,
            #4a151d 0%,
            #251017 50%,
            #111c2a 100%
        );

    font-size: 49px;

    text-shadow:
        0 0 16px rgba(200, 50, 61, .36);

    box-shadow:
        inset 0 0 0 5px rgba(170, 48, 55, .07),
        0 12px 20px rgba(0, 0, 0, .32);

    transform: translateX(-50%);
}

.collection-book .movie-image::after {
    position: absolute;

    inset: 8px;

    border: 1px solid rgba(212, 175, 99, .20);

    content: "";

    pointer-events: none;
}

.collection-book .book-info {
    position: relative;
    z-index: 2;

    display: block;

    width: 100%;

    padding: 0;

    text-align: center;
}

.collection-book .book-info strong {
    display: block;

    color: #f0e6d2;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: clamp(22px, 3vw, 29px);
    font-weight: normal;

    letter-spacing: .16em;

    line-height: 1.2;

    text-transform: uppercase;
}

.collection-book .book-info strong::after {
    display: block;

    width: 58px;
    height: 1px;

    margin: 15px auto 0;

    background: #a98242;

    content: "";
}

.collection-book .book-info > span {
    display: block;

    margin-top: 9px;

    color: #bda985;

    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 600;

    letter-spacing: .24em;

    text-transform: uppercase;
}

/* Antique bookshelf */
.collection-book .bookshelf {
    position: absolute;
    z-index: 1;

    right: 28px;
    bottom: 20px;
    left: 28px;

    height: 178px;

    pointer-events: none;
}

.collection-book .bookshelf::before {
    position: absolute;

    right: 0;
    bottom: 0;
    left: 0;

    height: 14px;

    border-top: 1px solid rgba(212, 175, 99, .45);

    background:
        linear-gradient(
            180deg,
            #5b3c24,
            #2b1b11
        );

    box-shadow:
        0 5px 12px rgba(0, 0, 0, .42),
        0 1px 0 rgba(255, 255, 255, .06) inset;

    content: "";
}

.collection-book .bookshelf::after {
    position: absolute;

    right: 0;
    bottom: 14px;
    left: 0;

    height: 4px;

    background: #8b6637;

    box-shadow:
        0 0 0 1px rgba(31, 20, 12, .7);

    content: "";
}

/* Book spines inside the shelf */
.collection-book .bookshelf-books {
    position: absolute;

    right: 7%;
    bottom: 18px;
    left: 7%;

    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;

    height: 145px;
}

.collection-book .bookshelf-books span {
    display: block;

    width: 24px;
    height: 116px;

    border: 1px solid rgba(20, 13, 8, .6);

    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, .22),
            rgba(255, 255, 255, .06) 42%,
            rgba(0, 0, 0, .25)
        ),
        #6d302c;

    box-shadow:
        2px 0 4px rgba(0, 0, 0, .22);
}

.collection-book .bookshelf-books span:nth-child(2n) {
    height: 132px;
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, .24),
            rgba(255, 255, 255, .06) 42%,
            rgba(0, 0, 0, .25)
        ),
        #394a52;
}

.collection-book .bookshelf-books span:nth-child(3n) {
    width: 28px;
    height: 124px;
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, .24),
            rgba(255, 255, 255, .06) 42%,
            rgba(0, 0, 0, .25)
        ),
        #7a5a2f;
}

.collection-book .bookshelf-books span:nth-child(4n) {
    height: 108px;
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, .24),
            rgba(255, 255, 255, .06) 42%,
            rgba(0, 0, 0, .25)
        ),
        #4b3c55;
}


/* =========================================================
   OPEN / CLOSE BUTTON
========================================================= */

.collection-book .open-book {
    position: absolute;
    z-index: 3;

    right: 32px;
    bottom: 25px;

    display: inline-flex;
    align-items: center;
    justify-content: flex-end;

    min-width: 82px;
    height: 28px;

    overflow: hidden;

    color: #d4af63;

    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 600;

    letter-spacing: .16em;

    white-space: nowrap;
}


/* ラベル共通 */

.collection-book .open-label,
.collection-book .close-label {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;

    white-space: nowrap;

    transition:
        opacity .34s ease,
        transform .48s cubic-bezier(.16, 1, .3, 1);
}


/* Open */

.collection-book .open-label {
    opacity: 1;

    transform:
        translateY(0);
}


/* Close */

.collection-book .close-label {
    position: absolute;

    right: 0;

    opacity: 0;

    transform:
        translateY(8px);

    pointer-events: none;
}


/* 開いた状態 */

.collection-book[aria-expanded="true"] .open-label {
    opacity: 0;

    transform:
        translateY(-8px);

    pointer-events: none;
}

.collection-book[aria-expanded="true"] .close-label {
    opacity: 1;

    transform:
        translateY(0);

    pointer-events: auto;
}


/* =========================================================
   COLLECTION LIST — CINEMA LIBRARY
========================================================= */

.book-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    width: 100%;
    margin-top: 0;
    padding: 0 18px 30px;
    max-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    opacity: 0;
    transform: translateY(-8px);
    border: 0;
    background: transparent;
    white-space: nowrap;
    scrollbar-width: thin;
    scrollbar-color: rgba(155,122,67,.6) transparent;
    transition:
        max-height .65s cubic-bezier(.16, 1, .3, 1),
        opacity .4s ease,
        transform .65s cubic-bezier(.16, 1, .3, 1),
        padding-top .65s cubic-bezier(.16, 1, .3, 1);
}

.collection-book[aria-expanded="true"] + .book-list {
    margin-top: 18px;
    padding-top: 22px;
    max-height: 520px;
    opacity: 1;
    transform: translateY(0);
}

/* The open collection is a horizontal library shelf. */

.book-list .collection-divider {
    display: flex;
    white-space: normal;
}

.book-list .youtube-preview {
    white-space: normal;
}

/* Opening choreography. */
.book-list .collection-divider,
.book-list .lesson-card,
.book-list .youtube-preview {
    opacity: 0;
    transform: translateY(-10px);
    transition:
        opacity .4s ease,
        transform .55s cubic-bezier(.16, 1, .3, 1);
}

.collection-book[aria-expanded="true"] + .book-list .collection-divider,
.collection-book[aria-expanded="true"] + .book-list .lesson-card,
.collection-book[aria-expanded="true"] + .book-list .youtube-preview {
    opacity: 1;
    transform: translateY(0);
}

.collection-book[aria-expanded="true"] + .book-list .collection-divider {
    transition-delay: .08s;
}

.collection-book[aria-expanded="true"] + .book-list .lesson-card:nth-of-type(2) {
    transition-delay: .14s;
}

.collection-book[aria-expanded="true"] + .book-list .lesson-card:nth-of-type(3) {
    transition-delay: .20s;
}

.collection-book[aria-expanded="true"] + .book-list .lesson-card:nth-of-type(4) {
    transition-delay: .26s;
}

.collection-book[aria-expanded="true"] + .book-list .lesson-card:nth-of-type(5) {
    transition-delay: .32s;
}

.collection-book[aria-expanded="true"] + .book-list .youtube-preview {
    transition-delay: .36s;
}

/* =========================================================
   HORIZONTAL VOCABULARY SHELF
========================================================= */

.lesson-card {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    vertical-align: bottom;
    flex: 0 0 190px;
    width: 190px;
    min-width: 190px;
    height: 250px;
    min-height: 250px;
    margin: 0 8px 0 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 2px;
    color: #eee4d0;
    background: transparent;
    box-shadow: none;
    text-align: left;
    transition:
        opacity .4s ease,
        transform .55s cubic-bezier(.16, 1, .3, 1);
}

.lesson-card:hover {
    transform: translateY(-3px);
    box-shadow: none;
    background: transparent;
}

.lesson-card::before {
    display: none;
}

.lesson-card::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 11px;
    border-top: 1px solid rgba(212, 175, 99, .42);
    background: linear-gradient(180deg, #624226, #2c1b10);
    box-shadow:
        0 5px 13px rgba(0, 0, 0, .38),
        0 1px 0 rgba(255, 255, 255, .05) inset;
    content: "";
}

.lesson-card .movie-image {
    position: relative;
    z-index: 2;
    flex: 0 0 112px;
    width: 112px;
    height: 178px;
    align-self: flex-end;
    margin: 0 0 11px 12px;
    border: 1px solid rgba(212, 175, 99, .38);
    border-radius: 1px 3px 3px 1px;
    color: #d5b06a;
    background:
        linear-gradient(90deg, rgba(0,0,0,.38), transparent 18%, rgba(255,255,255,.06) 52%, rgba(0,0,0,.25)),
        linear-gradient(160deg, #4a1b24, #21131b 65%, #10151d);
    font-size: 38px;
    box-shadow:
        -7px 0 0 #2b1718,
        0 10px 16px rgba(0,0,0,.35),
        inset 0 0 0 5px rgba(170,48,55,.05);
    transform-origin: bottom center;
    transition: transform .28s cubic-bezier(.16,1,.3,1), box-shadow .28s ease;
}

.lesson-card:nth-of-type(3n) .movie-image {
    background:
        linear-gradient(90deg, rgba(0,0,0,.38), transparent 18%, rgba(255,255,255,.06) 52%, rgba(0,0,0,.25)),
        linear-gradient(160deg, #243c43, #17232a 65%, #101316);
}

.lesson-card:nth-of-type(4n) .movie-image {
    background:
        linear-gradient(90deg, rgba(0,0,0,.38), transparent 18%, rgba(255,255,255,.06) 52%, rgba(0,0,0,.25)),
        linear-gradient(160deg, #66502b, #32271b 65%, #15120f);
}

.lesson-card:hover .movie-image {
    transform: translateY(-7px) rotate(-1.2deg);
    box-shadow:
        -7px 0 0 #2b1718,
        0 17px 24px rgba(0,0,0,.42),
        inset 0 0 0 5px rgba(170,48,55,.07);
}

.lesson-card .movie-image::before {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(212,175,99,.25);
    content: "";
    pointer-events: none;
}

.lesson-card .movie-image::after {
    position: absolute;
    right: 9px;
    bottom: 13px;
    left: 9px;
    height: 1px;
    border: 0;
    background: rgba(212,175,99,.35);
    content: "";
}

.lesson-card .book-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    flex: 1;
    padding: 0 20px 31px 20px;
}

.lesson-card .book-info > strong {
    display: block;
    width: 100%;
    color: #f0e6d2;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: normal;
    line-height: 1.3;
    letter-spacing: .035em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lesson-card .book-info > strong::after {
    display: block;
    width: 42px;
    height: 1px;
    margin-top: 9px;
    background: #a98242;
    content: "";
}

.lesson-card .progress-box {
    display: grid;
    grid-template-columns: auto minmax(60px, 1fr) auto;
    align-items: center;
    gap: 7px;
    width: 100%;
    margin-top: 10px;
}

.lesson-card .progress-label {
    color: #9e8a6a;
    font-family: Arial, sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .13em;
    white-space: nowrap;
}

.lesson-card .progress-track {
    height: 3px;
    overflow: hidden;
    border-radius: 0;
    background: rgba(212,175,99,.13);
}

.lesson-card .progress-fill {
    display: block;
    width: 0%;
    height: 100%;
    background: #a98242;
    transition: width .3s ease;
}

.lesson-card .progress-percent {
    color: #bda985;
    font-family: Arial, sans-serif;
    font-size: 8px;
    letter-spacing: .08em;
    white-space: nowrap;
}

.lesson-card .open-book {
    position: absolute;
    right: 20px;
    bottom: 34px;
    z-index: 3;
    color: #c6a966;
    font-family: Arial, sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .15em;
    white-space: nowrap;
}
/* =========================================================
   COLLECTION DIVIDER
========================================================= */

.collection-divider {
    display: flex;
    align-items: center;
    gap: 14px;

    margin: 0 4px 18px;
}

.collection-divider::before,
.collection-divider::after {
    flex: 1;

    height: 1px;

    background:
        rgba(128, 108, 77, .3);

    content: "";
}

.collection-divider span {
    color: #806c4d;

    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 600;

    letter-spacing: .2em;

    white-space: nowrap;
}


