    /* =====================================================
       READER TOP BAR
    ===================================================== */

    #vocabulary .reader-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;

        flex: 0 0 auto;

        width: 100%;
        height: 42px;

        margin: 0;

        padding-bottom: 7px;

        border-bottom:
            1px solid rgba(212, 175, 99, .18);
    }

    .back-button {
        padding: 6px 0;

        font-size: 9px;
        letter-spacing: .08em;
    }

    .back-button::before {
        font-size: 11px;
    }

    /* =====================================================
       BOOK SHELL
    ===================================================== */

    .book-shell {
        position: relative;

        display: flex;

        flex: 1 1 auto;

        width: 100%;

        min-height: 0;

        margin: 0;

        padding: 6px;

        overflow: hidden;

        border-radius: 5px;

        background:
            linear-gradient(
                145deg,
                #4d3422,
                #765136,
                #4c3220
            );

        box-shadow:
            0 17px 32px rgba(0, 0, 0, .38);
    }

    .vocabulary-page {
        position: relative;

        width: 100%;
        height: 100%;

        min-height: 0;

        padding: 0 5px;

        overflow: hidden;

        border: 1px solid rgba(130, 101, 59, .2);

        background:
            radial-gradient(
                ellipse at 50% 0%,
                rgba(255, 255, 255, .58),
                transparent 58%
            ),
            #fffaf0;

        box-shadow:
            inset 0 0 30px rgba(103, 73, 35, .12),
            0 12px 25px rgba(70, 46, 23, .2);
    }

    .vocabulary-page::before {
        height: 5px;

        margin:
            0
            -5px
            3px;
    }


    /* =====================================================
       WORD LIST
       4単語を無理に圧縮しすぎない
    ===================================================== */

    .word-list {
        display: flex;
        flex-direction: column;

        width: 100%;
        height: calc(100% - 8px);

        min-height: 0;

        overflow: hidden;
    }

    .word-entry {
        position: relative;

        flex: 0 0 25%;

        min-height: 0;
        height: 25%;

        overflow: hidden;
    }

    .word-entry::before {
        top: 10px;
        left: 5px;

        font-size: 8px;
    }


    /* =====================================================
       WORD FLIP
    ===================================================== */

    .word-flip {
        width: 100%;
        height: 100%;

        min-height: 0;

        padding:
            11px
            94px
            10px
            28px;

        overflow: hidden;
    }

    .word-flip-inner {
        width: 100%;
        height: 100%;

        min-height: 0;
    }

    .word-face {
        width: 100%;
        height: 100%;
    }

    .word {
        display: inline;

        font-size:
            clamp(18px, 5vw, 23px);

        line-height: 1.25;
    }

    .meaning {
        font-size:
            clamp(15px, 4vw, 19px);

        line-height: 1.3;
    }

    .word-level {
        margin-left: 4px;

        padding:
            3px
            5px;

        font-size: 6px;
    }

    .example {
        margin-top: 6px;

        font-size:
            clamp(11px, 3.1vw, 14px);

        line-height: 1.35;
    }

    .translation {
        margin-top: 5px;

        font-size:
            clamp(10px, 2.9vw, 13px);

        line-height: 1.35;
    }


    /* =====================================================
       FLIP HINT
    ===================================================== */

    .word-flip-hint {
        top: 50%;
        right: 5px;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 76px;
        height: 30px;

        margin: 0;

        color: #ad9b82;

        font-size: 9px;
        letter-spacing: .04em;

        line-height: 1.2;

        transform:
            translateY(-50%);
    }


    /* =====================================================
       SOUND
    ===================================================== */

    .speak-button {
        top: 7px;
        right: 5px;

        width: 76px;
        height: 34px;

        gap: 4px;

        border-radius: 7px;

        font-size: 12px;
    }


    /* =====================================================
       MASTERED
    ===================================================== */

    .master-button,
    .cancel-button {
        right: 5px;
        bottom: 5px;

        min-width: 76px;
        min-height: 31px;

        padding:
            5px
            7px;

        border-radius: 7px;

        font-size: 8px;
    }

    .word-entry.is-mastered::after {
        font-size: 28px;
    }


    /* =====================================================
       PAGE TURN
    ===================================================== */

    .page-turn {
        width: 28px;
        height: 56px;

        padding: 0;

        border-radius: 2px;

        background:
            linear-gradient(
                90deg,
                rgba(73, 46, 27, .96),
                rgba(119, 78, 47, .96)
            );

        box-shadow:
            0 4px 9px rgba(46, 27, 12, .35);
    }

    .page-turn span {
        font-size: 26px;
    }

    .page-turn small {
        display: none;
    }

    .page-turn-left {
        left: 3px;
    }

    .page-turn-right {
        right: 3px;
    }

    .flip-guide {
        flex: 0 0 auto;

        margin:
            6px
            0
            4px;

        color: #aeb5b5;

        font-size: 8px;
    }


    /* =====================================================
       AUTH
       ログイン画面もPC版の雰囲気を維持
    ===================================================== */

    #auth-screen {
        padding:
            20px
            18px;
    }

    .auth-card {
        width: 100%;

        padding:
            44px
            24px
            36px;
    }

    #auth-screen h2 {
        font-size: 31px;
    }

    .auth-subtitle {
        margin:
            12px
            0
            28px;

        font-size: 10px;

        line-height: 1.65;
    }

    #auth-screen input {
        padding: 13px 14px;

        font-size: 13px;
    }

    #login-button {
        padding: 13px;

        font-size: 11px;
    }

    #guest-button {
        padding: 11px;

        font-size: 10px;
    }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 540px) and (max-height: 700px) {

    #vocabulary .reader-topbar {
        height: 38px;
    }

    .book-heading {
        margin:
            7px
            0
            7px;
    }

    .book-heading h2 {
        font-size: 15px;
    }

    .word {
        font-size: 16px;
    }

    .meaning {
        font-size: 13px;
    }

    .example,
    .translation {
        font-size: 10px;

        line-height: 1.2;
    }

    .flip-guide {
        display: none;
    }

    .word-flip-hint {
        width: 74px;

        font-size: 8px;
    }

    .speak-button {
        width: 72px;
        height: 32px;

        font-size: 11px;
    }

    .master-button,
    .cancel-button {
        width: 72px;
        min-width: 72px;

        font-size: 8px;
    }
}
/* =========================================================
   ANTIQUE CINEMA ARCHIVE
   Global Design Override
========================================================= */

:root {
    --ink: #17130f;
    --ink-soft: #282019;

    --walnut: #342317;
    --walnut-light: #503521;
    --leather: #62442b;

    --paper: #f4ead7;
    --paper-dark: #ded0b7;
    --paper-shadow: #c5b294;

    --brass: #b08a4d;
    --brass-light: #d1ae69;
    --brass-dark: #80602f;

    --muted: #9d8c72;
    --muted-dark: #6f604d;

    --red: #722b2b;
}


/* =========================================================
   GLOBAL
========================================================= */

html {
    background: var(--ink);
}

body {
    color: #e9dfcd;

    background:
        radial-gradient(
            ellipse at 50% -15%,
            rgba(183, 144, 78, .12),
            transparent 42%
        ),
        radial-gradient(
            ellipse at 50% 30%,
            rgba(71, 49, 32, .22),
            transparent 65%
        ),
        linear-gradient(
            180deg,
            #1c1713 0%,
            #120f0c 48%,
            #0b0907 100%
        );

    font-family:
        Georgia,
        "Times New Roman",
        "Hiragino Mincho ProN",
        "Yu Mincho",
        serif;
}


/* 古い紙・インクのような微細な質感 */

body::before {
    position: fixed;
    z-index: -1;

    inset: 0;

    opacity: .18;

    background:
        repeating-linear-gradient(
            0deg,
            rgba(255,255,255,.018) 0,
            rgba(255,255,255,.018) 1px,
            transparent 1px,
            transparent 4px
        );

    content: "";

    pointer-events: none;
}


/* =========================================================
   HEADER
========================================================= */

header {
    position: relative;

    padding: 52px 24px 45px;

    border-bottom:
        1px solid rgba(193, 157, 88, .34);

    background:
        radial-gradient(
            ellipse at 50% -20%,
            rgba(206, 170, 98, .14),
            transparent 50%
        ),
        linear-gradient(
            180deg,
            #292017 0%,
            #1c1611 65%,
            #15100d 100%
        );

    box-shadow:
        0 18px 45px rgba(0,0,0,.48);
}


/* 上部の細い装飾線 */

header::before {
    position: absolute;

    top: 17px;
    left: 50%;

    width: min(620px, 70%);

    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(194,155,82,.5),
            transparent
        );

    content: "";

    transform: translateX(-50%);
}


/* 下部装飾 */

header::after {
    position: absolute;

    bottom: 10px;
    left: 50%;

    width: 110px;
    height: 1px;

    background: var(--brass-dark);

    content: "";

    transform: translateX(-50%);
}


.site-header-top {
