/* =========================================================
   YOUTUBE / WATCH THE TRAILER
========================================================= */

.youtube-preview {
    position: relative;

    display: grid;

    grid-template-columns: 150px 1fr;

    gap: 14px;

    align-items: center;

    width: calc(100% - 100px);

    max-width: 760px;

    margin:
        14px 50px 0;

    overflow: hidden;

    border: 1px solid rgba(89, 76, 54, .18);
    border-radius: 3px;

    color: #26374c;

    background:
        rgba(248, 244, 235, .8);

    box-shadow:
        0 4px 12px rgba(37, 32, 24, .05);

    font-family: Arial, sans-serif;

    text-decoration: none;

    transform:
        scale(.88);

    transform-origin:
        top center;

    opacity: .92;
}

.youtube-preview img {
    display: block;

    width: 150px;
    height: 84px;

    object-fit: cover;
}

.youtube-play {
    position: absolute;

    top: 27px;
    left: 58px;

    display: grid;
    place-items: center;

    width: 38px;
    height: 30px;

    border-radius: 8px;

    color: white;

    background: #d42128;

    font-size: 15px;
}

.youtube-caption {
    display: flex;
    flex-direction: column;

    gap: 5px;

    padding: 10px 14px;
}

.youtube-caption strong {
    color: #26374c;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: 13px;
}

.youtube-caption span {
