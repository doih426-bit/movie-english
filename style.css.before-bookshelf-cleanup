        linear-gradient(
            135deg,
            #79302f,
            #5d2425
        );
}

.cancel-button {
    border-radius: 1px;

    border-color: #8a806e;

    color: #4e5148;

    background: #eee8dc;
}


/* =========================================================
   PAGE TURN
========================================================= */

.page-turn {
    border-radius: 0;

    color: #e9d9bb;

    background:
        linear-gradient(
            90deg,
            #4d311d,
            #785131,
            #4d311d
        );

    box-shadow:
        0 8px 15px rgba(0,0,0,.42),
        inset 0 1px rgba(255,255,255,.08);
}

.page-turn:hover:not(:disabled) {
    background:
        linear-gradient(
            90deg,
            #5d3d24,
            #8a5e37,
            #5d3d24
        );
}


/* =========================================================
   AUTH — THE CINEMA ARCHIVE
========================================================= */

#auth-screen {
    background:
        radial-gradient(
            ellipse at 50% 10%,
            rgba(201,163,91,.12),
            transparent 42%
        ),
        linear-gradient(
            180deg,
            #292016,
            #15100c 70%,
            #090706
        );
}


/* 資料館の外枠 */

.auth-card {
    padding: 58px 50px 48px;

    border:
        1px solid rgba(194,155,82,.45);

    border-radius: 0;

    background:
        radial-gradient(
            ellipse at 50% 0%,
            rgba(208,171,99,.08),
            transparent 55%
        ),
        rgba(35,25,17,.78);

    box-shadow:
        0 35px 80px rgba(0,0,0,.55),
        inset 0 1px rgba(255,255,255,.06);
}


/* 二重枠 */

.auth-card::after {
    position: absolute;

    inset: 9px;

    border:
        1px solid rgba(194,155,82,.16);

    content: "";

    pointer-events: none;
}


.auth-eyebrow {
    color: #c7a55f;

    letter-spacing: .3em;
}


#auth-screen h2 {
    color: #eee1cc;

    letter-spacing: .08em;

    text-transform: uppercase;
}


.auth-subtitle {
    color: #9f907a;

    letter-spacing: .04em;
}


/* =========================================================
   INPUT
========================================================= */

#auth-screen input {
    border:
        1px solid rgba(192,151,83,.35);

    border-radius: 0;

    color: #2c241b;

    background:
        #eee4d1;
}

#auth-screen input:focus {
    border-color: #c4a05c;

    box-shadow:
        0 0 0 1px rgba(196,160,92,.18);
}


/* =========================================================
   LOGIN BUTTON
========================================================= */

#login-button {
    border:
        1px solid #a27a38;

    border-radius: 0;

    background:
        linear-gradient(
            135deg,
            #80602e,
            #b28a48,
            #795925
        );

    letter-spacing: .2em;

    box-shadow:
        0 7px 16px rgba(0,0,0,.35);
}

#login-button:hover {
    transform: translateY(-1px);

    filter: brightness(1.06);
}


/* =========================================================
   GUEST
========================================================= */

#guest-button {
    border-radius: 0;

    border-color:
        rgba(194,155,82,.38);

    color: #c0a77a;
}

#guest-button:hover {
    border-color:
        rgba(194,155,82,.7);

    background:
        rgba(194,155,82,.06);
}


/* =========================================================
   AUTH DIVIDER
========================================================= */

.auth-divider {
    color: #746753;

    letter-spacing: .24em;
}


/* =========================================================
   MOBILE — SAME ANTIQUE WORLD
========================================================= */

@media (max-width: 768px) {

    header {
        padding:
            36px
            18px
            31px;
    }

    header::before {
        top: 12px;

        width: 78%;
    }

    .site-header-top h1 {
        font-size: 25px;

        letter-spacing: .08em;
    }

    .site-header-top > div > p:last-child {
        font-size: 8px;

        letter-spacing: .2em;
    }

    main {
        width:
            calc(100% - 28px);

        margin:
            38px
            auto
            55px;
    }

    main h2 {
        font-size: 22px;

        letter-spacing: .05em;
    }


    /* Collection */

    .collection-book {
        min-height: 300px;

        padding:
            28px
            18px
            25px;
    }

    .collection-book .book-info strong {
        font-size: 17px;

        letter-spacing: .12em;
    }

    .collection-book .book-info > span {
        font-size: 6px;

        letter-spacing: .18em;
    }


    /* Lesson */

    .lesson-card {
        flex-basis: 146px;

        width: 146px;
        min-width: 146px;

        height: 198px;
    }

    .lesson-card .book-info > strong {
        font-size: 12px;

        letter-spacing: .04em;
    }


    /* Reader */

    #vocabulary {
        background:
            radial-gradient(
                ellipse at 50% 0%,
                rgba(188,148,82,.10),
                transparent 42%
            ),
            linear-gradient(
                180deg,
                #201912,
                #0e0b08
            );
    }

    .book-shell {
        border-radius: 1px;

        background:
            linear-gradient(
                145deg,
                #4f331f,
                #704a2d,
                #40291a
            );
    }

    .vocabulary-page {
        background:
            radial-gradient(
                ellipse at 50% 0%,
                rgba(255,255,255,.75),
                transparent 55%
            ),
            #f2e6d1;
    }


    /* Auth */

    .auth-card {
        padding:
            48px
            24px
            40px;
    }

    #auth-screen h2 {
        font-size: 29px;

        letter-spacing: .06em;
    }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 540px) and (max-height: 700px) {

    .site-header-top h1 {
        font-size: 22px;
    }

    main {
        margin-top: 30px;
    }

    .collection-book {
        min-height: 275px;
    }

    .book-heading h2 {
        font-size: 15px;
    }
}
/* =========================================================

/* =========================================================
   CINEMA BOOKSHELF
   SINGLE CLEAN VERSION
========================================================= */

.content-list {
    width: 100%;
}

.library-content {
    width: 100%;
    margin-bottom: 80px;
}

.content-header {
    width: 100%;
    margin-bottom: 28px;
    text-align: center;
}

.content-plaque {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.content-kicker {
    display: block;
    margin-bottom: 9px;
    color: #b59a6b;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .28em;
    text-transform: uppercase;
}

.content-plaque h2 {
    margin: 0;
    color: #eadfcd;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: .08em;
}

.content-plaque p {
    margin: 10px auto 0;
    max-width: 600px;
    color: #9e907d;
    font-size: 12px;
}

/* =========================================================
   SHELF
========================================================= */

.bookshelf-frame {
    position: relative;
    width: 100%;
    padding: 30px 0 70px;
    overflow: hidden;
}

.bookshelf-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-behavior: smooth;
}

.bookshelf-viewport::-webkit-scrollbar {
    display: none;
}

.bookshelf-track {
    display: flex;
    align-items: flex-start;
    gap: 30px;
    width: max-content;
    padding: 20px 40vw 30px;
    box-sizing: border-box;
}

/* =========================================================
   BOOK
========================================================= */

.shelf-book {
    position: relative;
    flex: 0 0 230px;
    width: 230px;
    height: 330px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    scroll-snap-align: center;
    transition:
        transform .35s ease,
        filter .35s ease;
}

.shelf-book:hover {
    transform: translateY(-10px);
    filter: brightness(1.08);
}

/* =========================================================
   COVER
========================================================= */

.book-cover {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;

    border: 1px solid rgba(203,165,92,.55);

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.45),
            transparent 18%,
            rgba(255,255,255,.07) 52%,
            rgba(0,0,0,.32)
        ),
        linear-gradient(
            160deg,
            #63282b,
            #32191b 65%,
            #171114
        );

    box-shadow:
        -9px 0 #241517,
        0 20px 35px rgba(0,0,0,.48);
}

.book-cover::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 17px;

    background:
        linear-gradient(
            90deg,
            #241416,
            #5d2528,
            #301719
        );

    border-right: 1px solid rgba(215,176,98,.32);
    content: "";
}

/* =========================================================
   COVER CONTENT
========================================================= */

.book-cover-inner {
    position: absolute;
    inset: 15px;
    left: 29px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(212,175,99,.28);

    padding: 20px;
    box-sizing: border-box;

    text-align: center;
}

.book-symbol {
    margin-bottom: 24px;
    color: #d1ad69;
    font-size: 25px;
}

.book-cover-rule {
    display: block;
    width: 85px;
    height: 1px;
    margin: 0 auto 17px;
    background: rgba(211,173,96,.48);
}

.book-cover-rule.short {
    width: 45px;
    margin: 17px auto 13px;
}

.book-cover-title {
    display: block;
    max-width: 170px;

    color: #ead9b9;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: 20px;
    line-height: 1.35;
    letter-spacing: .045em;
    text-align: center;
}

.book-cover-label {
    color: #ad9160;
    font-family: Arial, sans-serif;
    font-size: 7px;
    letter-spacing: .23em;
}

/* =========================================================
   HIDDEN DETAILS
========================================================= */

.book-details {
    display: none;
}

.open-book {
    display: none;
}

/* =========================================================
   SHELF
========================================================= */

.bookshelf-frame::after {
    display: block;

    width: calc(100% - 30px);
    height: 10px;

    margin: 0 auto;

    border-top: 1px solid rgba(207,166,91,.45);

    background:
        linear-gradient(
            180deg,
            #76512f,
            #332014
        );

    box-shadow: 0 9px 18px rgba(0,0,0,.45);

    content: "";
}

/* =========================================================
   BOOK VARIATIONS
========================================================= */

.shelf-book:nth-child(3n) .book-cover {
    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.45),
            transparent 18%,
            rgba(255,255,255,.07) 52%,
            rgba(0,0,0,.32)
        ),
        linear-gradient(
            160deg,
            #31474a,
            #1c292b 65%,
            #101314
        );
}

.shelf-book:nth-child(4n) .book-cover {
    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.45),
            transparent 18%,
            rgba(255,255,255,.07) 52%,
            rgba(0,0,0,.32)
        ),
        linear-gradient(
            160deg,
            #71572d,
            #38291b 65%,
            #17120e
        );
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

    .content-plaque h2 {
        font-size: 21px;
    }

    .bookshelf-track {
        gap: 18px;
        padding:
            15px
            30px
            25px;
    }

    .shelf-book {
        flex-basis: 165px;
        width: 165px;
        height: 235px;
    }

    .book-cover-title {
        font-size: 17px;
    }

    .book-symbol {
        margin-bottom: 15px;
        font-size: 17px;
    }
}
.bookshelf-frame {
    min-height: 330px;
}

.bookshelf-viewport {
    height: 290px;
    min-height: 290px;
}

.bookshelf-track {
    height: 290px;
    min-height: 290px;
    align-items: flex-start;
}
