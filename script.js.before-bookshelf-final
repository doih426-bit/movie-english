async function loadBooksForContentFrontend(
    contentId,
    targetBookList
) {
    const {
        data,
        error
    } =
        await supabaseClient
            .from("books")
            .select(`
                id,
                title,
                description,
                content_id
            `)
            .eq(
                "content_id",
                contentId
            )
            .order(
                "id",
                {
                    ascending: true
                }
            );
    if (error) {
        console.error(
            "Frontend books load error:",
            error
        );
        return;
    }
    console.log(
    "BOOKS FOR CONTENT:",
    contentId,
    data
);
    targetBookList.innerHTML = "";
    /*
       現在のユーザー
    */
    let user = null;
    if (!isGuest) {
        const {
            data: {
                session
            },
            error: sessionError
        } =
            await supabaseClient.auth
                .getSession();
        if (sessionError) {
            console.error(
                "Book progress session load error:",
                sessionError
            );
        } else {
            user =
                session?.user || null;
        }
    }
    /*
       BOOK ID一覧
    */
    const bookIds =
        (data || []).map(
            book => book.id
        );
    /*
       単語を一括取得
    */
    let allWords = [];
    if (
        bookIds.length > 0
    ) {
        const {
            data: wordRows,
            error: wordError
        } =
            await supabaseClient
                .from("words")
                .select(
                    "id, book_id"
                )
                .in(
                    "book_id",
                    bookIds
                );
        if (wordError) {
            console.error(
                "Book words load error:",
                wordError
            );
        } else {
            allWords =
                wordRows || [];
        }
    }
    /*
       WORD ID一覧
    */
    const allWordIds =
        allWords.map(
            word => word.id
        );
    /*
       ユーザーのMastered情報を一括取得
    */
    let progressRows = [];
    if (
        user &&
        allWordIds.length > 0
    ) {
        const {
            data: progressData,
            error: progressError
        } =
            await supabaseClient
                .from(
                    "user_word_progress"
                )
                .select(
                    "word_id, mastered"
                )
                .eq(
                    "user_id",
                    user.id
                )
                .in(
                    "word_id",
                    allWordIds
                );
        if (progressError) {
            console.error(
                "Book progress load error:",
                progressError
            );
        } else {
            progressRows =
                progressData || [];
        }
    }
    /*
       Mastered word ID Set
    */
    const masteredWordIdSet =
        new Set(
            progressRows
                .filter(
                    row =>
                        row.mastered === true
                )
                .map(
                    row =>
                        row.word_id
                )
        );
    /*
       本ごとの単語IDを作成
    */
    const bookIdToWordIds = {};
    for (
        const bookId
        of bookIds
    ) {
        bookIdToWordIds[bookId] =
            [];
    }
    for (
        const word
        of allWords
    ) {
        if (
            bookIdToWordIds[word.book_id]
        ) {
            bookIdToWordIds[
                word.book_id
            ].push(
                word.id
            );
        }
    }
    /*
       BOOKを描画
    */
    for (
        const book
        of data || []
    ) {
        const wordIds =
            bookIdToWordIds[
                book.id
            ] || [];
        const totalWords =
            wordIds.length;
        let masteredCount =
            0;
        if (
            user &&
            totalWords > 0
        ) {
            masteredCount =
                wordIds.filter(
                    id =>
                        masteredWordIdSet.has(
                            id
                        )
                ).length;
        }
        const progressPercent =
            totalWords > 0
                ? Math.round(
                    (
                        masteredCount /
                        totalWords
                    ) *
                    100
                )
                : 0;
        const button =
            document.createElement(
                "button"
            );
        button.className =
            "shelf-book";
        button.type =
            "button";
        button.innerHTML = `
            <span
                class="book-cover"
                aria-hidden="true"
            >
                <span class="book-cover-inner">
                    <span class="book-symbol">
                        ✦
                    </span>
                    <span
                        class="book-cover-rule"
                    ></span>
                    <span
                        class="book-cover-title"
                    >
                        ${escapeHtml(
                            book.title
                        )}
                    </span>
                    <span
                        class="book-cover-rule short"
                    ></span>
                    <span
                        class="book-cover-label"
                    >
                        MOVIE ENGLISH
                    </span>
                </span>
            </span>
            <span class="book-details">
                <strong>
                    ${escapeHtml(
                        book.title
                    )}
                </strong>
                <span class="book-meta">
                    ${escapeHtml(
                        book.description ||
                        "ENGLISH THROUGH CINEMA"
                    )}
                </span>
                <span class="progress-box">
                    <span class="progress-label">
                        PROGRESS
                    </span>
                    <span class="progress-track">
                        <span
                            class="progress-fill"
                            style="width: ${progressPercent}%"
                        ></span>
                    </span>
                    <span class="progress-percent">
                        ${progressPercent}%
                    </span>
