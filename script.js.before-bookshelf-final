/* =========================================================
   BOOKSHELF — DRAG SCROLL
========================================================= */

document.addEventListener(
    "mousedown",
    event => {
        const shelf =
            event.target.closest(
                ".bookshelf-frame"
            );

        if (!shelf) {
            return;
        }

        shelf.dataset.dragging =
            "true";

        shelf.dataset.startX =
            event.clientX;

        shelf.dataset.scrollLeft =
            shelf.scrollLeft;

        shelf.classList.add(
            "is-dragging"
        );
    }
);

document.addEventListener(
    "mousemove",
    event => {
        const shelves =
            document.querySelectorAll(
                ".bookshelf-frame"
            );

        shelves.forEach(
            shelf => {
                if (
                    shelf.dataset.dragging !==
                    "true"
                ) {
                    return;
                }

                const startX =
                    Number(
                        shelf.dataset.startX
                    );

                const startScroll =
                    Number(
                        shelf.dataset.scrollLeft
                    );

                const distance =
                    event.clientX -
                    startX;

                shelf.scrollLeft =
                    startScroll -
                    distance;
            }
        );
    }
);

document.addEventListener(
    "mouseup",
    () => {
        document
            .querySelectorAll(
                ".bookshelf-frame"
            )
            .forEach(
                shelf => {
                    shelf.dataset.dragging =
                        "false";

                    shelf.classList.remove(
                        "is-dragging"
                    );
                }
            );
    }
);