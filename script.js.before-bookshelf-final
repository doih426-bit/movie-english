/*
   UPDATE BOOK POSITION
*/

function updateBookPosition(
    smooth = true
) {

    const target =
        bookElements[
            currentBookIndex
        ];

    if (!target) {
        return;
    }


    bookElements.forEach(
        (book, index) => {

            book.classList.toggle(
                "is-selected",
                index === currentBookIndex
            );

        }
    );


    const trackRect =
        targetBookList.getBoundingClientRect();

    const targetRect =
        target.getBoundingClientRect();


    const offset =
        (
            trackRect.left +
            trackRect.width / 2
        )
        -
        (
            targetRect.left +
            targetRect.width / 2
        );


    targetBookList.style.transition =
        smooth
            ? "transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)"
            : "none";


    targetBookList.style.transform =
        `translateX(${offset}px)`;
}


