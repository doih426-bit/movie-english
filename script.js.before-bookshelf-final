/* =========================================================
   BUILD STUDY WORDS
========================================================= */
function buildStudyWords() {
    studyWords =
        dbWords
            .map(
                (item, index) => ({
                    id:
                        item.id,
                    book_id:
                        item.book_id,
                    word:
                        item.word,
                    index,
                    difficulty:
                        item.difficulty ||
                        "easy"
                })
            )
            .sort(
                (a, b) =>
                    difficultyRank[
                        a.difficulty
                    ] -
                    difficultyRank[
                        b.difficulty
                    ]
                    ||
                    a.index -
                    b.index
            );
    console.log(
        "Study words:",
        studyWords
    );
}
/* =========================================================
