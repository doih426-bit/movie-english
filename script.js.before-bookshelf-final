========================================================= */
function openVocabularyBook(
    bookId,
    bookTitle
) {
    console.log(
        "Opening book:",
        bookId,
        bookTitle
    );
    const numericBookId =
        Number(bookId);
    if (
        !Number.isFinite(
            numericBookId
        )
    ) {
        console.error(
            "Invalid book ID:",
            bookId
        );
        return;
    }
    currentBookId =
        numericBookId;
    currentBookTitle =
        bookTitle || "";
    /*
       選択した本の単語だけ取得
    */
    studyWords =
        dbWords
            .filter(
                item =>
                    Number(
                        item.book_id
                    ) ===
                    currentBookId
            )
            .map(
                (item, index) => ({
                    id:
                        item.id,
                    book_id:
                        item.book_id,
                    word:
                        item.word,
                    index,
                    difficulty:
                        item.difficulty ||
                        "easy"
                })
            )
            .sort(
                (a, b) =>
                    difficultyRank[
                        a.difficulty
                    ] -
                    difficultyRank[
                        b.difficulty
                    ]
                    ||
                    a.index -
                    b.index
            );
    console.log(
        "Selected book words:",
        studyWords
    );
    if (
        studyWords.length === 0
    ) {
        console.warn(
            "No words found for book:",
            currentBookId
        );
        return;
    }
    /*
       タイトル更新
    */
    const bookTitleElement =
        document.querySelector(
            "#book-title"
        );
    if (
        bookTitleElement
    ) {
        bookTitleElement.textContent =
            currentBookTitle;
    }
    /*
       Libraryを隠す
    */
    if (
        movieList
    ) {
        movieList.classList.add(
            "hidden"
        );
    }
    /*
       Vocabularyを表示
    */
    if (
        vocabulary
    ) {
        vocabulary.classList.remove(
            "hidden"
        );
    }
    /*
       最初のページ
    */
    currentPage = 0;
    /*
       描画
    */
    renderPage();
    /*
       ページ上部へ
    */
    window.scrollTo({
        top: 0,
        behavior:
            "smooth"
    });
}
